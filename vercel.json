{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,style.css,script.js,frontend/**,backend/**}"
    },
    "api/**": {
      "includeFiles": "{backend/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__pran_api_path=/api/$1"
    }
  ]
}
