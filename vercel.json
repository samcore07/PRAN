{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,style.css,script.js,frontend/**}"
    },
    "index.js": {
      "includeFiles": "{index.html,style.css,script.js,frontend/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
