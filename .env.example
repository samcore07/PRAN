# ============================================
# PRAN - Supabase & Environment Configuration (Template)
# ============================================

# Supabase Project URL (From Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Used by client and frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (Used securely on backend with admin privileges)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Backend Server Configuration
PORT=5001
NODE_ENV=development
